# This is an example file. Copy this to .env and fill in your actual credentials.

# Credentials for the Aster Perpetual API (Ethereum-based)
API_USER=0xYOUR_WALLET_ADDRESS_HERE
API_SIGNER=0xYOUR_WALLET_ADDRESS_HERE
API_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE_64_HEX_CHARS

# Credentials for the Aster Spot API (API Key/Secret)
APIV1_PUBLIC_KEY=your_spot_public_key_here
APIV1_PRIVATE_KEY=your_spot_private_key_here
